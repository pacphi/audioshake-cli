{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "cargo: settings",
      "matchCategories": [
        "rust"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "rust"
      ],
      "commitMessagePrefix": "deps(rust):"
    },
    {
      "description": "cargo: group rust-minor",
      "matchCategories": [
        "rust"
      ],
      "groupName": "rust-minor",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "github-actions"
      ],
      "commitMessagePrefix": "deps(actions):"
    },
    {
      "description": "github-actions: group actions-all",
      "matchCategories": [
        "ci"
      ],
      "groupName": "actions-all",
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "prConcurrentLimit": 15
}
